{
    "compilerOptions": {
        "target": "ES2017",
        "module": "esnext",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "declaration": true,
        "declarationDir": "dist",
        "strict": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "jsx": "react",
        "outDir": "dist"
    },
    "include": [
        "src/components/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}